# FreeCRM — configuration de la stack Docker Compose locale.
# Copier en `.env` à la racine puis ajuster si besoin :  cp .env.example .env
# Toutes ces variables ont une valeur par défaut dans docker-compose.yml :
# le fichier .env n'est nécessaire que pour surcharger.

# --- Ports exposés sur l'hôte ---------------------------------------------
# À changer si le port est déjà occupé par un autre projet sur votre machine.
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
# Stack de test API (profil "test"), isolée de la vraie base.
BACKEND_TEST_PORT=18081

# --- Base de données -------------------------------------------------------
# Projet 100% local : ces identifiants ne sont pas des secrets de production.
POSTGRES_DB=freecrm
POSTGRES_USER=freecrm
POSTGRES_PASSWORD=freecrm

# --- Backend Symfony -------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1
MESSENGER_TRANSPORT_DSN=sync://

# --- IA (App\Ai\..., optionnelle) ------------------------------------------
# Le CRM fonctionne intégralement sans ces variables (clé vide par défaut) :
# aucune fonctionnalité IA n'est activée/obligatoire tant qu'elle n'est pas définie.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# --- Frontend Next.js ------------------------------------------------------
# URL appelée depuis le navigateur : doit correspondre à BACKEND_PORT ci-dessus.
NEXT_PUBLIC_API_URL=http://localhost:8080
